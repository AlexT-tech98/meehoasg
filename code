function buildProdOrderIndex_(){
  const byId={},all=[],legacyDuplicateIds={};
  orderSheets_().forEach(sh=>{
    const last=orderDataLastRow_(sh);if(last<2)return;
    const rows=sh.getRange(2,1,last-1,APP.ORDER_WIDTH).getValues();
    rows.forEach((r,i)=>{
      const rawDate=r[1];if(rawDate===''||rawDate===null)return;
      const d=dateFromCell_(rawDate,sh.getName()),id=clean_(r[14]);if(!d)return;
      const loc={id:id,sheet:sh.getName(),sheetId:sh.getSheetId(),row:i+2,date:d,time:time_(r[2])};
      all.push(loc);
      if(id)(byId[id]||(byId[id]=[])).push(loc);
    });
  });
  Object.keys(byId).forEach(id=>{if(byId[id].length>1)legacyDuplicateIds[id]=byId[id];});
  return{byId:byId,all:all,legacyDuplicateIds:legacyDuplicateIds,total:all.length};
}
function resolveProdSettlementSource_(id,sourceSheet,sourceRow,index){
  id=clean_(id);sourceSheet=clean_(sourceSheet);sourceRow=Math.floor(money_(sourceRow));
  if(!id)return{ok:false,reason:'EMPTY_ID'};
  const candidates=(index.byId[id]||[]).slice();
  if(sourceSheet){
    const same=candidates.filter(x=>x.sheet===sourceSheet);
    if(sourceRow>=2){
      const exact=same.find(x=>x.row===sourceRow);
      if(exact)return{ok:true,loc:exact,mode:'EXACT_HINT'};
    }
    if(same.length===1)return{ok:true,loc:same[0],mode:'UNIQUE_IN_HINT_SHEET'};
    if(same.length>1)return{ok:false,reason:'AMBIGUOUS_IN_HINT_SHEET',candidates:same};
  }
  if(candidates.length===1)return{ok:true,loc:candidates[0],mode:'UNIQUE_GLOBAL'};
  if(!candidates.length)return{ok:false,reason:'NOT_FOUND',candidates:[]};
  return{ok:false,reason:'AMBIGUOUS_GLOBAL',candidates:candidates};
}
function auditProdOrderIntegrity_(){
  const index=buildProdOrderIndex_(),current=sheetForDate_(new Date()),currentName=current.getName();
  const currentRows=index.all.filter(x=>x.sheet===currentName),currentIds={},currentDuplicates=[],currentWrongSheet=[],currentUnsorted=[],currentBlankIds=[];
  let prev=null;
  currentRows.forEach(x=>{
    if(!x.id)currentBlankIds.push({sheet:x.sheet,row:x.row});
    else if(currentIds[x.id])currentDuplicates.push({id:x.id,first:currentIds[x.id],second:{sheet:x.sheet,row:x.row}});
    else currentIds[x.id]={sheet:x.sheet,row:x.row};
    const expected=configuredOrderSheetForDate_(x.date);
    if(!expected.sheet||expected.sheet.getSheetId()!==current.getSheetId())currentWrongSheet.push({id:x.id,sheet:x.sheet,row:x.row,date:iso_(x.date),expectedSheet:expected.sheet?expected.sheet.getName():expected.key});
    if(prev&&compareOrderKey_(prev.date,prev.time,x.date,x.time)>0)currentUnsorted.push({sheet:x.sheet,row:x.row,id:x.id});
    prev=x;
  });

  // PENDING is the only historical source scope that can still mutate during cutover.
  // Resolve each business order against its stored source hint; duplicated requests for one order are intentionally grouped.
  const setSh=dbSheet_('SETTLEMENT_REQUESTS'),setLast=setSh.getLastRow(),pendingLocations={},pendingProblems=[],pendingOrderIds={};let pendingRequestCount=0;
  if(setLast>=2){
    const rows=setSh.getRange(2,1,setLast-1,19).getValues();
    rows.forEach((r,i)=>{
      if(clean_(r[13]).toUpperCase()!=='PENDING')return;
      pendingRequestCount++;
      const id=clean_(r[1]);if(!id){pendingProblems.push({row:i+2,reason:'EMPTY_ORDER_ID'});return;}
      if(pendingOrderIds[id])return;
      pendingOrderIds[id]=true;
      const resolved=resolveProdSettlementSource_(id,r[2],r[3],index);
      if(!resolved.ok){pendingProblems.push({orderId:id,row:i+2,reason:resolved.reason,count:(resolved.candidates||[]).length});return;}
      const loc=resolved.loc,expected=configuredOrderSheetForDate_(loc.date);
      if(!expected.sheet||expected.sheet.getSheetId()!==loc.sheetId){
        pendingProblems.push({orderId:id,row:i+2,reason:'SOURCE_WRONG_MONTH',sourceSheet:loc.sheet,date:iso_(loc.date),expectedSheet:expected.sheet?expected.sheet.getName():expected.key});return;
      }
      pendingLocations[id]=loc;
    });
  }

  // Legacy Jan-Jul/Aug archive can contain pre-V7 copied rows and historical anomalies.
  // They are reported as warnings, never used as a deploy gate unless they affect current month or a PENDING source.
  const legacyDuplicateCount=Object.keys(index.legacyDuplicateIds).length;
  return{
    total:index.total,
    currentSheet:currentName,
    currentRows:currentRows.length,
    currentDuplicates:currentDuplicates,
    currentWrongSheet:currentWrongSheet,
    currentUnsorted:currentUnsorted,
    currentBlankIds:currentBlankIds,
    pendingRequestCount:pendingRequestCount,
    pendingOrderCount:Object.keys(pendingOrderIds).length,
    pendingLocations:pendingLocations,
    pendingProblems:pendingProblems,
    legacyDuplicateCount:legacyDuplicateCount
  };
}
function prodCutoverPreflight() {
  const required=['ORDER_SPREADSHEET_ID','DATABASE_SPREADSHEET_ID','ORDER_SHEET_NAMES','ORDER_IMAGE_FOLDER_ID','BILL_FOLDER_ID'];
  const missing=required.filter(k=>!prop_(k));
  if(missing.length) throw new Error('PROD CUTOVER BLOCKED: thiếu Script Properties: '+missing.join(', '));
  if(prop_('ORDER_SPREADSHEET_ID')!=='1TsVOtDWrqlkjEUPGWmRudGEvGe38qLG0S62MOVDefpM') throw new Error('PROD CUTOVER BLOCKED: ORDER_SPREADSHEET_ID không phải live sheet.');
  if(prop_('DATABASE_SPREADSHEET_ID')!=='1t0ikb14Nb3ayz1KdY75Xmef2trIoSY0mlV0KrpxXueA') throw new Error('PROD CUTOVER BLOCKED: DATABASE_SPREADSHEET_ID không phải live DB.');
  DriveApp.getFolderById(prop_('ORDER_IMAGE_FOLDER_ID'));DriveApp.getFolderById(prop_('BILL_FOLDER_ID'));
  _resetRuntimeV7_();assertCanonicalDb_();
  if(dbSheet_('ORDER_META').getName()!=='MIG_ORDER_META_V6'||dbSheet_('SETTLEMENT_REQUESTS').getName()!=='MIG_SETTLEMENT_V6') throw new Error('PROD CUTOVER BLOCKED: canonical DB binding sai.');
  const boundaryAudit=auditOrderDataBoundaries_();
  if(!boundaryAudit.ok)throw new Error('PROD CUTOVER BLOCKED: order boundary mismatch — '+JSON.stringify(boundaryAudit.mismatches));
  const audit=auditProdOrderIntegrity_();
  const blockers=audit.currentDuplicates.length+audit.currentWrongSheet.length+audit.currentUnsorted.length+audit.currentBlankIds.length+audit.pendingProblems.length;
  if(blockers)throw new Error(
    'PROD CUTOVER BLOCKED: current duplicate '+audit.currentDuplicates.length+
    ', current sai tab '+audit.currentWrongSheet.length+
    ', current sai thứ tự '+audit.currentUnsorted.length+
    ', current thiếu ID '+audit.currentBlankIds.length+
    ', pending source lỗi '+audit.pendingProblems.length+'.'
  );
  const current=sheetForDate_(new Date());
  const report={
    ok:true,build:APP.BUILD,orders:audit.total,
    currentSheet:audit.currentSheet,currentRows:audit.currentRows,
    pendingRequests:audit.pendingRequestCount,pendingOrders:audit.pendingOrderCount,
    legacyDuplicateWarnings:audit.legacyDuplicateCount,
    logicalLastRow:orderDataLastRow_(current),
    verifiedLastRow:orderDataLastRowVerified_(current),
    boundarySheets:boundaryAudit.items.length,
    metaSheet:dbSheet_('ORDER_META').getName(),
    settlementSheet:dbSheet_('SETTLEMENT_REQUESTS').getName(),
    message:'PROD CUTOVER PREFLIGHT PASS'
  };
  console.log(JSON.stringify(report,null,2));
  console.log('✅ PROD CUTOVER PREFLIGHT PASS — '+APP.BUILD);
  return report;
}
function prepareProdCutoverDataV7(){
  const gate=prodCutoverPreflight(),audit=auditProdOrderIntegrity_(),sh=dbSheet_('SETTLEMENT_REQUESTS'),last=sh.getLastRow();
  if(last<2)return{ok:true,updated:0,missing:[],preflight:gate};
  const vals=sh.getRange(2,1,last-1,19).getValues(),hints=vals.map(r=>[r[2],r[3]]);let updated=0,pendingRows=0;
  vals.forEach((r,i)=>{
    if(clean_(r[13]).toUpperCase()!=='PENDING')return;
    pendingRows++;
    const id=clean_(r[1]),loc=audit.pendingLocations[id];
    if(!loc)throw new Error('PROD CUTOVER BLOCKED: PENDING '+id+' chưa resolve được source.');
    if(clean_(r[2])!==loc.sheet||Number(r[3])!==loc.row)updated++;
    hints[i]=[loc.sheet,loc.row];
  });
  if(updated){
    sh.getRange(2,3,hints.length,2).setValues(hints);SpreadsheetApp.flush();invalidateSettlementState_();
  }
  const report={ok:true,build:APP.BUILD,updated:updated,pendingRows:pendingRows,settlements:vals.length,missing:[],message:'PROD CUTOVER DATA READY'};
  console.log(JSON.stringify(report,null,2));console.log('✅ PROD CUTOVER DATA READY — '+APP.BUILD);return report;
}

