function normalizeRange_(p){let start=parseDate_(p&&p.start),end=parseDate_(p&&p.end),now=new Date();if(!start&&!end){start=new Date(now.getFullYear(),now.getMonth(),now.getDate());end=new Date(now.getFullYear(),now.getMonth(),now.getDate());}else{if(!start)start=new Date(end.getFullYear(),end.getMonth(),end.getDate());if(!end)end=new Date(start.getFullYear(),start.getMonth(),start.getDate());}start.setHours(0,0,0,0);end.setHours(23,59,59,999);if(end<start)throw new Error('Ngày kết thúc phải từ ngày bắt đầu trở đi.');if((end-start)/86400000>366)throw new Error('Khoảng ngày tối đa 366 ngày.');return{start:start,end:end};}
function parsePaid_(v,total,settledTotal){
  const fullAmount=Math.max(0,money_(total)), settledAmount=Math.max(0,money_(settledTotal));
  if(settledAmount>0)return settledAmount;
  if(typeof v==='number'){if(v>0&&v<=1000)return v*1000;return Math.max(0,v);}
  const s=clean_(v).toLowerCase();if(!s)return 0;
  if(/chưa|chua/.test(s))return 0;
  if(/full|đã tt|da tt|đã thanh toán|da thanh toan|thanh toán đủ|thanh toan du/.test(s))return fullAmount;
  const m=s.replace(/\s/g,'').match(/(?:cọc|coc|tt|thanh|da)?([0-9.,]+)(k|tr|triệu|trieu)?/);if(!m)return 0;
  let n=Number(m[1].replace(/[.,]/g,''));if(!isFinite(n)||n<=0)return 0;
  if(m[2]==='k'||(n>0&&n<=1000))n*=1000;if(m[2]==='tr'||m[2]==='triệu'||m[2]==='trieu')n*=1000000;
  return n;
}
function isShopShip_(v){return normalizeText_(v).indexOf('shop')>=0;}
function deriveStatus_(r){return bool_(r[7])?'Đã giao':bool_(r[6])?'Đã bó':'Chờ bó';} function contact_(p,a){return [p?'SĐT: '+p:'',a?'Địa chỉ: '+a:''].filter(Boolean).join('\n');} function phoneFromContact_(v){const m=String(v||'').match(/(?:SĐT|SDT)\s*:\s*([^\n]+)/i);return m?m[1].trim():'';} function addressFromContact_(v){return String(v||'').replace(/(?:SĐT|SDT)\s*:\s*[^\n]+\n?/i,'').replace(/^Địa chỉ\s*:\s*/i,'').trim();}
function dateFromCell_(v,name){if(v instanceof Date&&!isNaN(v))return v;const d=parseDate_(v);if(d)return d;const m=String(name).match(/(\d{1,2})\/(\d{4})/);return m?new Date(+m[2],+m[1]-1,1):null;} function parseDate_(v){if(v instanceof Date)return v;const s=clean_(v),m=s.match(/^(\d{4})-(\d{2})-(\d{2})$/);if(m)return new Date(+m[1],+m[2]-1,+m[3]);const n=s.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})$/);return n?new Date(+n[3],+n[2]-1,+n[1]):null;}
function time_(v){if(v instanceof Date)return Utilities.formatDate(v,APP.TZ,'HH:mm');return clean_(v).slice(0,5);} function iso_(d){return d?Utilities.formatDate(d,APP.TZ,'yyyy-MM-dd'):'';}
function prop_(k){if(Object.prototype.hasOwnProperty.call(V7_TEST_CONFIG,k))return clean_(V7_TEST_CONFIG[k]);if(Object.prototype.hasOwnProperty.call(_RT.props,k))return _RT.props[k];const v=clean_(PropertiesService.getScriptProperties().getProperty(k));_RT.props[k]=v;return v;} function version_(k){return Number(prop_(k)||1);} function bumpVersion_(k){PropertiesService.getScriptProperties().setProperty(k,String(version_(k)+1));}
function newId_(p){return p+'-'+Utilities.formatDate(new Date(),APP.TZ,'yyMMddHHmmss')+'-'+Utilities.getUuid().replace(/-/g,'').slice(0,8).toUpperCase();}
function money_(v){const n=Number(String(v==null?'0':v).replace(/[^0-9.-]/g,''));return isFinite(n)?Math.round(n):0;} function bool_(v){return v===true||String(v).toLowerCase()==='true'||String(v)==='1';} function clean_(v){return String(v==null?'':v).trim();} function normalizeText_(v){return clean_(v).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d');} function normalizeUsername_(v){return normalizeText_(v).replace(/\s+/g,'');} function json_(v,d){try{return JSON.parse(v||'');}catch(e){return d;}} function validUrl_(u){return /^https?:\/\//i.test(u);} function fail_(m){return{ok:false,message:'Lỗi: '+m};}
